# Copie este arquivo para ".env" e troque os valores.
# O ".env" está no .gitignore: suas senhas nunca vão para o GitHub.

# Banco de dados
DB_NAME=vendas
DB_USERNAME=vendas
DB_PASSWORD=troque-esta-senha
DB_URL=jdbc:postgresql://localhost:5432/vendas

# JWT: use no mínimo 32 caracteres aleatórios (ex.: openssl rand -base64 48)
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
JWT_EXPIRACAO_MINUTOS=60

# Administrador criado automaticamente na primeira execução
ADMIN_EMAIL=admin@vendas.local
ADMIN_PASSWORD=troque-esta-senha-tambem
